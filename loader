local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Ali-lov3/ConcordeLib/refs/heads/main/Source.lua"))()

local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local Window = Library:CreateWindow({
    Title = "Inde Loader",
    Logo = "rocket",
    ConfigFolder = "IndeLoader",
    OpenKey = Enum.KeyCode.RightShift,
})

local function Notify(title, text, duration, kind)
    pcall(function() Window:Notify(title, text, duration or 3, kind or "Info") end)
end

---------------------------------------------------------------
-- Inject logic
---------------------------------------------------------------
local Injected = {}

local function Inject(entry)
    if Injected[entry.Name] then
        Notify("Loader", entry.Name .. " is already injected.", 3, "Warning")
        return
    end
    if not entry.Url or entry.Url == "" then
        Notify("Loader", "No URL set for " .. entry.Name .. " — edit the Scripts list at the Top of the loader file.", 5, "Error")
        return
    end
    Notify("Loader", "Injecting " .. entry.Name .. "...", 3, "Info")
    task.spawn(function()
        local okHttp, src = pcall(function() return game:HttpGet(entry.Url) end)
        if not okHttp or not src or src == "" then
            Notify("Loader", "Failed to download " .. entry.Name .. ". Check the URL.", 5, "Error")
            return
        end
        local fn, compileErr = (loadstring or load)(src)
        if not fn then
            Notify("Loader", entry.Name .. " failed to compile: " .. tostring(compileErr), 6, "Error")
            return
        end
        local okRun, runErr = pcall(fn)
        if not okRun then
            Notify("Loader", entry.Name .. " errored: " .. tostring(runErr), 6, "Error")
            return
        end
        Injected[entry.Name] = true
        Notify("Loader", entry.Name .. " injected! Closing loader...", 2, "Success")
        task.delay(1, function()
            if Window and Window.Destroy then Window:Destroy() end
        end)
    end)
end

