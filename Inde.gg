-- ESP Tab - FIXED with toggle state handling
local ESPTab = Window:CreateTab("ESPTab", nil)
local ESPSection = ESPTab:CreateSection("ESPTab")
local espActive = false
local espObjects = {}

local function clearESP()
   for _, obj in pairs(espObjects) do
      if obj and obj.Parent then
         obj:Destroy()
      end
   end
   espObjects = {}
end

local function createESP(player)
   if not espActive then return end
   if player == game.Players.LocalPlayer then return end
   if not player.Character or not player.Character:FindFirstChild("Head") then return end
   
   local espBox = Instance.new("BoxHandleAdornment")
   espBox.Adornee = player.Character:WaitForChild("Head")
   espBox.Size = Vector3.new(2, 2, 2)
   espBox.Color3 = Color3.fromRGB(255, 0, 0)
   espBox.AlwaysOnTop = true
   espBox.ZIndex = 10
   espBox.Parent = player.Character
   espBox.Visible = true
   table.insert(espObjects, espBox)
   
   player.CharacterAdded:Connect(function()
      if espBox and espBox.Parent then
         espBox:Destroy()
      end
   end)
end

local ToggleESP = ESPTab:CreateToggle({
   Name = "ESP TOGGLE",
   CurrentValue = false,
   Flag = "ToggleESP",
   Callback = function(Value)
      espActive = Value
      if Value then
         clearESP()
         for _, player in ipairs(game.Players:GetPlayers()) do
            createESP(player)
         end
      else
         clearESP()
      end
   end,
})

game.Players.PlayerAdded:Connect(function(player)
   if espActive then
      createESP(player)
   end
end)

-- AIMBOT Tab - FIXED with proper toggle and cleanup
local AIMBOTTab = Window:CreateTab("AIMBOT", nil)
local Section = AIMBOTTab:CreateSection("AIMBOT")
local aimbotActive = false
local aimbotTarget = nil
local aimbotConnection = nil

local function getClosestPlayer()
   local localPlayer = game.Players.LocalPlayer
   local closest = nil
   local closestDist = math.huge
   local camera = game.Workspace.CurrentCamera
   local viewportCenter = camera.ViewportSize / 2
   
   for _, player in pairs(game.Players:GetPlayers()) do
      if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
         local pos, onScreen = camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
         if onScreen then
            local dist = (Vector2.new(pos.X, pos.Y) - viewportCenter).Magnitude
            if dist < closestDist and dist < 100 then
               closestDist = dist
               closest = player
            end
         end
      end
   end
   return closest
end

local function aimbotLoop()
   if not aimbotActive then return end
   local target = getClosestPlayer()
   if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
      local camera = game.Workspace.CurrentCamera
      local targetPos = target.Character.HumanoidRootPart.Position
      camera.CFrame = CFrame.new(camera.CFrame.Position, targetPos)
   end
end

local ToggleAimbot = AIMBOTTab:CreateToggle({
   Name = "AIMBOT TOGGLE (Hold Z)",
   CurrentValue = false,
   Flag = "ToggleAimbot",
   Callback = function(Value)
      aimbotActive = Value
      if Value then
         if aimbotConnection then aimbotConnection:Disconnect() end
         aimbotConnection = game:GetService("RunService").RenderStepped:Connect(aimbotLoop)
      else
         if aimbotConnection then
            aimbotConnection:Disconnect()
            aimbotConnection = nil
         end
      end
   end,
})

-- Keybind toggle for aimbot
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
   if gameProcessed then return end
   if input.KeyCode == Enum.KeyCode.Z then
      aimbotActive = not aimbotActive
      if aimbotActive then
         if aimbotConnection then aimbotConnection:Disconnect() end
         aimbotConnection = game:GetService("RunService").RenderStepped:Connect(aimbotLoop)
         ToggleAimbot:SetValue(true)
      else
         if aimbotConnection then
            aimbotConnection:Disconnect()
            aimbotConnection = nil
         end
         ToggleAimbot:SetValue(false)
      end
   end
end)

-- Teleport Tab - FIXED with proper player selection
local TeleportTab = Window:CreateTab("Teleport", nil)
local TeleportSection = TeleportTab:CreateSection("Teleport System")

local SelectedPlayer = nil

local function GetPlayerNames()
   local names = {}
   for _, player in pairs(game.Players:GetPlayers()) do
      if player ~= game.Players.LocalPlayer then
         table.insert(names, player.Name)
      end
   end
   return names
end

local PlayerDropdown = TeleportTab:CreateDropdown({
   Name = "Select Player",
   Options = GetPlayerNames(),
   CurrentOption = nil,
   MultipleOptions = false,
   Flag = "TeleportPlayer",
   Callback = function(option)
      SelectedPlayer = option
   end,
})

local function TeleportToPlayer()
   if not SelectedPlayer then
      Rayfield:Notify({Title = "Teleport Failed", Content = "No player selected!", Duration = 3})
      return
   end
   local target = game.Players:FindFirstChild(SelectedPlayer)
   if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
      Rayfield:Notify({Title = "Teleport Failed", Content = "Player not found or not loaded!", Duration = 3})
      return
   end
   local localPlayer = game.Players.LocalPlayer
   if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
      Rayfield:Notify({Title = "Teleport Failed", Content = "You have no character!", Duration = 3})
      return
   end
   localPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0)
   Rayfield:Notify({Title = "Teleport Success", Content = "Teleported to " .. SelectedPlayer, Duration = 3})
end

local TeleportButton = TeleportTab:CreateButton({
   Name = "Teleport",
   Callback = TeleportToPlayer,
})

game.Players.PlayerAdded:Connect(function()
   PlayerDropdown:SetOptions(GetPlayerNames())
end)
game.Players.PlayerRemoving:Connect(function()
   PlayerDropdown:SetOptions(GetPlayerNames())
end)

-- GUNS Tab - FIXED with working duplication
local GUNSTab = Window:CreateTab("GUNS", nil)
local Section = GUNSTab:CreateSection("GUNS")

local DupeButton = GUNSTab:CreateButton({
   Name = "DUPEGUNS",
   Callback = function()
      local player = game.Players.LocalPlayer
      local backpack = player.Backpack
      local tools = {}
      for _, item in ipairs(backpack:GetChildren()) do
         if item:IsA("Tool") then
            table.insert(tools, item)
         end
      end
      if #tools == 0 then
         Rayfield:Notify({Title = "Dupe Failed", Content = "No tools found in backpack!", Duration = 3})
         return
      end
      for _, tool in pairs(tools) do
         local clone = tool:Clone()
         clone.Parent = backpack
      end
      Rayfield:Notify({Title = "Dupe Success", Content = "Duplicated " .. #tools .. " tools!", Duration = 3})
   end,
})

-- Name ESP - FIXED with toggle state
local nameEspActive = false
local nameEspObjects = {}

local function clearNameESP()
   for _, obj in pairs(nameEspObjects) do
      if obj and obj.Parent then
         obj:Destroy()
      end
   end
   nameEspObjects = {}
end

local function createNameESP(player)
   if not nameEspActive then return end
   if player == game.Players.LocalPlayer then return end
   if not player.Character or not player.Character:FindFirstChild("Head") then return end
   
   local billboard = Instance.new("BillboardGui")
   billboard.Adornee = player.Character:WaitForChild("Head")
   billboard.Size = UDim2.new(0, 100, 0, 50)
   billboard.StudsOffset = Vector3.new(0, 3, 0)
   billboard.AlwaysOnTop = true
   billboard.Parent = player.Character
   
   local label = Instance.new("TextLabel")
   label.Text = player.Name
   label.TextSize = 14
   label.TextColor3 = Color3.fromRGB(255, 255, 255)
   label.BackgroundTransparency = 1
   label.Size = UDim2.new(1, 0, 1, 0)
   label.Parent = billboard
   table.insert(nameEspObjects, billboard)
end

local ToggleNameESP = ESPTab:CreateToggle({
   Name = "NAMES",
   CurrentValue = false,
   Flag = "ToggleNameESP",
   Callback = function(Value)
      nameEspActive = Value
      if Value then
         clearNameESP()
         for _, player in pairs(game.Players:GetPlayers()) do
            createNameESP(player)
         end
      else
         clearNameESP()
      end
   end,
})

game.Players.PlayerAdded:Connect(function(player)
   if nameEspActive then
      createNameESP(player)
   end
end)

